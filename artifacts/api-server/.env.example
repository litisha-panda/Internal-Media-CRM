# ── Local development environment ──────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp artifacts/api-server/.env.example artifacts/api-server/.env

# PostgreSQL connection string
# After running setup-local-db.sh this will be:
DATABASE_URL=postgres://<your-pg-user>@localhost:5432/otv_crm_local

# TCP port the API server listens on
PORT=3000

# Anthropic API key — required for RO parser and AI features
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# These two vars are also checked by lib/integrations-anthropic-ai.
# For local dev, set them to the standard Anthropic API values:
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=    # same value as ANTHROPIC_API_KEY

# Zoho CRM integration — optional, only needed for client/agency search
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# CORS allowed origin — defaults to http://localhost:5173 when not set
# ALLOWED_ORIGIN=http://localhost:5173

NODE_ENV=development
